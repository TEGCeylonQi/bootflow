{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BootFlow",
  "version": "0.2.0",
  "identifier": "io.github.bootflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BootFlow — 启动项体检",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BootFlow Contributors",
    "copyright": "MIT Licensed",
    "shortDescription": "看清并编排 Windows 开机启动项",
    "longDescription": "BootFlow 把 Windows 上散落在多处的开机自启机制统一收拢，用可视化方式排序时序、建立依赖，且任何改动都可一键回滚，回滚有独立脚本兜底。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
